# Neon — projeto Spykke. `neon link --project-id blue-brook-31593596 --branch production`
# preenche automaticamente DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH e NEON_AUTH_*.
DATABASE_URL=postgresql://USER:SENHA@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:SENHA@HOST/neondb?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://HOST.neonauth.REGIAO.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://HOST.neonauth.REGIAO.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Segredo dos cookies de sessão (gere com: openssl rand -base64 32). Não vem do Neon.
NEON_AUTH_COOKIE_SECRET=troque-por-32-caracteres-ou-mais

# Branch "test" do Spykke (npm test / pytest)
TEST_DATABASE_URL=postgresql://USER:SENHA@HOST-pooler/neondb?sslmode=require
NEON_API_KEY=napi_...

# Vercel Blob (fotos)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# AI service (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
